# Proxmox VE Connection
proxmox_endpoint  = "https://pve01.yourdomain.com:8006/"
proxmox_api_token = "root@pam!tofu-token=00000000-0000-0000-0000-000000000000"
proxmox_insecure  = true

# Network Configuration
gateway        = "10.90.16.1"
nameservers    = ["1.1.1.1", "8.8.8.8"]
network_bridge = "vmbr0"
vlan_tag       = 90 # Set null for untagged, or integer e.g. 90 for tagged VLAN

# Cloud-Init & Storage
default_user         = "admin"
user_password_hash   = null # Set e.g. "$6$..." from openssl passwd -6 or leave null to disable password auth
ssh_public_key       = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... admin@workstation"
cloud_init_node      = "pve01"
cloud_image_id       = "local:iso/noble-server-cloudimg-amd64.img"
snippet_storage_pool = "local"
vm_storage_pool      = "local-lvm"

# RKE2 Cluster Auto-Join
rke2_server_url = "https://10.90.16.50:9345"
rke2_token      = "REPLACE_WITH_YOUR_RKE2_TOKEN"
rke2_version    = "v1.37.2+rke2r1"

# --- 1. Control Plane Master Nodes ---
masters = {
  "rke2-master1" = {
    vmid        = 101
    target_node = "pve01"
    ip          = "10.90.16.41"
    cores       = 4
    memory      = 8192
    disk_size   = 50
  }
  "rke2-master2" = {
    vmid        = 102
    target_node = "pve02"
    ip          = "10.90.16.42"
    cores       = 4
    memory      = 8192
    disk_size   = 50
  }
  "rke2-master3" = {
    vmid        = 103
    target_node = "pve03"
    ip          = "10.90.16.43"
    cores       = 4
    memory      = 8192
    disk_size   = 50
  }
}

# --- 2. Dedicated Longhorn Storage Nodes ---
storage_nodes = {
  "rke2-longhorn1" = {
    vmid              = 120
    target_node       = "pve01"
    ip                = "10.90.16.46"
    cores             = 4
    memory            = 16384
    os_disk_size      = 50
    data_disk_size    = 1450 # ~1.45 TB dedicated disk for Longhorn replicas
    data_storage_pool = "local-lvm"
  }
  "rke2-longhorn2" = {
    vmid              = 121
    target_node       = "pve02"
    ip                = "10.90.16.48"
    cores             = 4
    memory            = 16384
    os_disk_size      = 50
    data_disk_size    = 1450
    data_storage_pool = "local-lvm"
  }
  "rke2-longhorn3" = {
    vmid              = 122
    target_node       = "pve03"
    ip                = "10.90.16.52"
    cores             = 4
    memory            = 16384
    os_disk_size      = 50
    data_disk_size    = 1450
    data_storage_pool = "local-lvm"
  }
}

# --- 3. Compute Worker Nodes ---
workers = {
  "rke2-worker1" = {
    vmid            = 131
    target_node     = "pve04"
    ip              = "10.90.16.44"
    cores           = 4
    memory          = 12288
    disk_size       = 50
    passthrough_gpu = "0000:00:02.0" # Direct PCIe address or Proxmox mapping name e.g. "iGPU"
  }
  "rke2-worker2" = {
    vmid            = 132
    target_node     = "pve01"
    ip              = "10.90.16.45"
    cores           = 4
    memory          = 12288
    disk_size       = 50
    passthrough_gpu = "iGPU"
  }
  "rke2-worker3" = {
    vmid            = 133
    target_node     = "pve02"
    ip              = "10.90.16.49"
    cores           = 4
    memory          = 12288
    disk_size       = 50
    passthrough_gpu = "iGPU"
  }
  "rke2-worker4" = {
    vmid            = 134
    target_node     = "pve05"
    ip              = "10.90.16.51"
    cores           = 4
    memory          = 12288
    disk_size       = 50
    passthrough_gpu = "iGPU"
  }
  "rke2-worker5" = {
    vmid            = 135
    target_node     = "pve06"
    ip              = "10.90.16.53"
    cores           = 4
    memory          = 12288
    disk_size       = 50
    passthrough_gpu = "iGPU"
  }
  "rke2-worker6" = {
    vmid            = 136
    target_node     = "pve07"
    ip              = "10.90.16.54"
    cores           = 4
    memory          = 12288
    disk_size       = 50
    passthrough_gpu = "iGPU"
  }
}
